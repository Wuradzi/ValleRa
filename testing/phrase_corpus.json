{
  "description": "Еталонний текстовий корпус фраз (аудит №7): очікувані ЛОКАЛЬНІ рішення без LLM, мікрофона й мережі. Перевіряються лише вказані в expect поля. direct=true — лише допуск до локального gate перед підтвердженням, не дозвіл виконати дію. Зміна очікування — свідоме рішення з поясненням у note.",
  "fields": {
    "command_prefix": "COMMAND_PREFIX.match(text) — режим «Команда»",
    "stop": "STOP_SPEECH.fullmatch(text) — зупинка мовлення",
    "control": "DIALOGUE_CONTROLS за нормалізованим текстом: continue/repeat/shorter/simpler або null",
    "direct": "direct_request(final_request(request), '') — прямий запит до асистента, не оповідь/заперечення/цитата; розмовний вступ перед запитом не блокує його",
    "scope": "request_scope(request): open_app/find_files/weather/window_control або null",
    "window": "window_request(request): [action, name] або null",
    "needs_proposal": "голе посилання без власника (needs_proposal)",
    "short_clarification": "short_clarification(text) — може продовжити scoped-уточнення",
    "app_name": "application_name_reply(text): назва програми або null",
    "confirm": "ConfirmationService._decision(text): yes/no/unknown (UI/текст, без confidence)",
    "confirm_voice_low": "те саме з голосовою confidence 0.7: так → unknown, ні → no",
    "memory": "parse_request(text): [операція, вміст] або null",
    "query": "search_query(final_request(request)): слова користувача для вебпошуку"
  },
  "phrases": [
    {"id": "stop_plain", "category": "stop", "source": "voice", "text": "стоп", "expect": {"stop": true, "direct": false}},
    {"id": "stop_command", "category": "stop", "source": "voice", "text": "Команда, стоп.", "expect": {"stop": true, "command_prefix": true}},
    {"id": "stop_silence", "category": "stop", "source": "voice", "text": "Замовкни!", "expect": {"stop": true}},
    {"id": "stop_tts", "category": "stop", "source": "text", "text": "зупини озвучення", "expect": {"stop": true}},
    {"id": "stop_in_sentence", "category": "stop", "source": "voice", "text": "Стоп, а що таке оперативна пам'ять?", "expect": {"stop": false}},

    {"id": "control_continue", "category": "dialogue_control", "source": "voice", "text": "Продовжуй.", "expect": {"control": "continue", "direct": false}},
    {"id": "control_repeat", "category": "dialogue_control", "source": "voice", "text": "Повтори останнє", "expect": {"control": "repeat", "scope": null}, "note": "Dialogue control обробляється до natural turn."},
    {"id": "control_shorter", "category": "dialogue_control", "source": "text", "text": "Скажи коротше", "expect": {"control": "shorter"}},
    {"id": "control_simpler", "category": "dialogue_control", "source": "voice", "text": "Поясни простіше", "expect": {"control": "simpler"}},
    {"id": "control_not_question", "category": "dialogue_control", "source": "voice", "text": "Повтори, будь ласка, що таке SSD", "expect": {"control": null, "direct": true, "scope": null}, "note": "Спостереження 30.10.2026: «повтори» входить у прямі дієслова заради workplace_retry, тому загальний gate (tool='') пропускає фразу; локальний scope=null, інструмент не визначено. Не змінено без рішення користувача."},

    {"id": "confirm_yes", "category": "confirmation", "source": "voice", "text": "Так.", "expect": {"confirm": "yes", "confirm_voice_low": "unknown", "app_name": null}},
    {"id": "confirm_yes_repeated", "category": "confirmation", "source": "voice", "text": "Так! Так!", "expect": {"confirm": "yes", "confirm_voice_low": "unknown"}, "note": "Повтор одного слова нормалізується; confidence gate збережено."},
    {"id": "confirm_no_repeated", "category": "confirmation", "source": "voice", "text": "Ні, ні!", "expect": {"confirm": "no", "confirm_voice_low": "no"}, "note": "Повтор одного заперечення є відмовою."},
    {"id": "confirm_mixed_repeated", "category": "confirmation", "source": "voice", "text": "Так, так, ні", "expect": {"confirm": "unknown", "confirm_voice_low": "unknown"}, "note": "Змішану згоду та відмову не спрощувати."},
    {"id": "confirm_yes_full", "category": "confirmation", "source": "voice", "text": "Так, підтверджую", "expect": {"confirm": "yes"}},
    {"id": "confirm_ok", "category": "confirmation", "source": "text", "text": "гаразд", "expect": {"confirm": "yes", "app_name": null}},
    {"id": "confirm_no", "category": "confirmation", "source": "voice", "text": "Ні", "expect": {"confirm": "no", "confirm_voice_low": "no", "app_name": null}},
    {"id": "confirm_cancel", "category": "confirmation", "source": "voice", "text": "Не треба!", "expect": {"confirm": "no", "app_name": null}},
    {"id": "confirm_refuse", "category": "confirmation", "source": "voice", "text": "відмовляюсь", "expect": {"confirm": "no"}},
    {"id": "confirm_yes_but", "category": "confirmation", "source": "voice", "text": "Так, але відкрий інший", "expect": {"confirm": "unknown"}},
    {"id": "confirm_maybe", "category": "confirmation", "source": "voice", "text": "Мабуть", "expect": {"confirm": "unknown"}},
    {"id": "confirm_sure_not_alias", "category": "confirmation", "source": "voice", "text": "Звісно", "expect": {"confirm": "unknown"}, "note": "Позитивні синоніми навмисно не розширено (J57)."},

    {"id": "memory_list", "category": "memory", "source": "voice", "text": "Що ти пам'ятаєш про мене?", "expect": {"memory": ["list", ""]}},
    {"id": "memory_clear", "category": "memory", "source": "voice", "text": "Забудь усе про мене", "expect": {"memory": ["clear", ""]}},
    {"id": "memory_remember", "category": "memory", "source": "text", "text": "Запам'ятай проєкт: Рейвен", "expect": {"memory": ["remember", "проєкт: Рейвен"]}},
    {"id": "memory_forget", "category": "memory", "source": "voice", "text": "Забудь про проєкт", "expect": {"memory": ["forget", "про проєкт"]}},
    {"id": "memory_update", "category": "memory", "source": "text", "text": "Онови пам'ять: браузер Firefox", "expect": {"memory": ["update", "браузер Firefox"]}},
    {"id": "memory_reported", "category": "memory", "source": "voice", "text": "Він сказав запам'ятай це", "expect": {"memory": null}},
    {"id": "memory_file_is_documents", "category": "memory", "source": "voice", "text": "Забудь файл", "expect": {"memory": ["forget", "файл"]}, "note": "parse_request теж розпізнає; «забудь файл» перехоплює DocumentReading раніше в process."},

    {"id": "open_browser", "category": "action_request", "source": "voice", "text": "Відкрий браузер", "expect": {"direct": true, "scope": "open_app", "window": null}},
    {"id": "open_polite", "category": "action_request", "source": "voice", "text": "Рейвен, будь ласка, відкрий Telegram", "expect": {"direct": true, "scope": "open_app"}},
    {"id": "open_can_you", "category": "action_request", "source": "voice", "text": "Чи можеш ти відкрити блокнот?", "expect": {"direct": true, "scope": "open_app"}},
    {"id": "open_want", "category": "action_request", "source": "voice", "text": "Я хотів би, щоб ти відкрив калькулятор", "expect": {"direct": true, "scope": "open_app"}},
    {"id": "open_voice_repair", "category": "action_request", "source": "voice", "text": "Відкрив браузер", "expect": {"direct": true, "scope": "open_app"}, "note": "Вузький голосовий ремонт дієслова; підтвердження все одно потрібне."},
    {"id": "open_text_no_repair", "category": "non_action", "source": "text", "text": "Відкрив браузер", "expect": {"direct": false}, "note": "Текст не ремонтується: минулий час — оповідь."},
    {"id": "find_files", "category": "action_request", "source": "voice", "text": "Знайди файл звіту за жовтень", "expect": {"direct": true, "scope": "find_files"}},
    {"id": "find_web_not_files", "category": "action_request", "source": "voice", "text": "Знайди в інтернеті документацію Python", "expect": {"direct": true, "scope": null}},
    {"id": "weather", "category": "action_request", "source": "voice", "text": "Яка погода в Луцьку завтра?", "expect": {"direct": true, "scope": "weather"}},
    {"id": "workplace", "category": "action_request", "source": "voice", "text": "Підготуй робоче місце", "expect": {"direct": true}},

    {"id": "lead_in_search", "category": "action_request", "source": "voice", "text": "Щоб тобі таке сказати, я навіть не знаю. Знайди мені інформацію про ресорджементо.", "expect": {"direct": true, "query": "ресорджементо"}, "note": "Жива сесія 30.10.2026: заперечення у вступі раніше блокувало прямий запит."},
    {"id": "lead_in_greeting", "category": "action_request", "source": "voice", "text": "Привіт. Відкрий браузер.", "expect": {"direct": true, "scope": "open_app"}},
    {"id": "search_info_phrase", "category": "action_request", "source": "voice", "text": "Знайди інформацію про ресорджменту.", "expect": {"direct": true, "query": "ресорджменту"}, "note": "Без «інформацію про» і крапки; написання STT не виправляється моделлю."},
    {"id": "search_plain_words", "category": "action_request", "source": "voice", "text": "Знайди рецепт без цукру", "expect": {"query": "рецепт без цукру"}},

    {"id": "window_maximize", "category": "window", "source": "voice", "text": "Розгорни вікно Telegram", "expect": {"direct": true, "scope": "window_control", "window": ["maximize", "Telegram"]}},
    {"id": "window_minimize_bare", "category": "window", "source": "voice", "text": "Згорни", "expect": {"window": ["minimize", ""]}},
    {"id": "window_restore", "category": "window", "source": "voice", "text": "Віднови програму браузер", "expect": {"window": ["restore", "браузер"]}},
    {"id": "window_voice_repair", "category": "window", "source": "voice", "text": "Розгорнені вікно браузера", "expect": {"window": ["maximize", "браузера"]}},

    {"id": "negation", "category": "non_action", "source": "voice", "text": "Не відкривай браузер. Я лише запитую, чи ти вмієш це робити.", "expect": {"direct": false, "scope": null}},
    {"id": "negation_short", "category": "non_action", "source": "voice", "text": "Не відкривай браузер", "expect": {"direct": false}},
    {"id": "conditional", "category": "non_action", "source": "voice", "text": "Якщо буде час, відкрий браузер", "expect": {"direct": false}},
    {"id": "negated_lead_in", "category": "non_action", "source": "voice", "text": "Не відкривай браузер. Відкрий блокнот.", "expect": {"direct": false}, "note": "Дієслово дії у вступі зберігає всю репліку для gate (fail closed)."},
    {"id": "reported_speech", "category": "non_action", "source": "voice", "text": "Він сказав відкрий браузер", "expect": {"direct": false}},
    {"id": "quoted", "category": "non_action", "source": "text", "text": "Відкрий «браузер»", "expect": {"direct": false}},
    {"id": "translate", "category": "non_action", "source": "voice", "text": "Переклади відкрий браузер англійською", "expect": {"direct": false}},
    {"id": "question_about_opening", "category": "non_action", "source": "voice", "text": "Що ти відкрив минулого разу?", "expect": {"direct": false}},
    {"id": "multi_action", "category": "non_action", "source": "voice", "text": "Відкрий браузер і знайди погоду", "expect": {"direct": false}, "note": "Кілька дій в одній репліці не проходять прямий gate."},
    {"id": "sensitive", "category": "non_action", "source": "voice", "text": "Знайди мій пароль від пошти", "expect": {"direct": false}},
    {"id": "chat_question", "category": "non_action", "source": "voice", "text": "Чим оперативна пам'ять відрізняється від накопичувача SSD?", "expect": {"direct": false, "command_prefix": false}},
    {"id": "chat_greeting", "category": "non_action", "source": "voice", "text": "Привіт, Рейвен. Як у тебе справи?", "expect": {"direct": false, "stop": false, "control": null}},

    {"id": "bare_reference", "category": "bare_reference", "source": "voice", "text": "Зроби це", "expect": {"needs_proposal": true, "direct": false}},
    {"id": "bare_second", "category": "bare_reference", "source": "voice", "text": "Другий.", "expect": {"needs_proposal": true}},
    {"id": "bare_open", "category": "bare_reference", "source": "voice", "text": "відкривай", "expect": {"needs_proposal": true}},
    {"id": "not_bare", "category": "bare_reference", "source": "voice", "text": "Відкрий другий файл", "expect": {"needs_proposal": false}},

    {"id": "scoped_app_name", "category": "scoped_reply", "source": "voice", "text": "Telegram", "expect": {"short_clarification": true, "app_name": "Telegram", "direct": false}},
    {"id": "scoped_app_two_words", "category": "scoped_reply", "source": "voice", "text": "Visual Studio Code.", "expect": {"app_name": "Visual Studio Code"}},
    {"id": "scoped_negated", "category": "scoped_reply", "source": "voice", "text": "Ні, не той", "expect": {"short_clarification": false, "app_name": null}},
    {"id": "scoped_new_action", "category": "scoped_reply", "source": "voice", "text": "Відкрий Telegram", "expect": {"short_clarification": false}, "note": "Нова пряма дія не продовжує попереднє уточнення."},
    {"id": "scoped_sentence", "category": "scoped_reply", "source": "voice", "text": "Я сьогодні трохи втомився", "expect": {"app_name": null}},
    {"id": "scoped_sensitive", "category": "scoped_reply", "source": "voice", "text": "мій пароль", "expect": {"short_clarification": false, "app_name": null}},

    {"id": "command_browser", "category": "command_mode", "source": "voice", "text": "Команда, відкрий браузер.", "expect": {"command_prefix": true, "direct": false}, "note": "У режимі «Команда» дію веде роутер; природний gate не застосовується до тексту з префіксом."},
    {"id": "command_colon", "category": "command_mode", "source": "text", "text": "Команда: знайди в інтернеті ЛНТУ", "expect": {"command_prefix": true}},
    {"id": "command_word_inside", "category": "command_mode", "source": "voice", "text": "Яка команда виграла матч?", "expect": {"command_prefix": false}},
    {"id": "command_team_word", "category": "command_mode", "source": "voice", "text": "Командами в терміналі я не користуюсь", "expect": {"command_prefix": false}}
  ]
}
